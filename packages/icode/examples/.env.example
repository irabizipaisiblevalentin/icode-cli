# Copy to ~/.config/icode/.env or export these.
# NEVER commit a real key. The key is read from the environment only.

# Required for Kinyarwanda language intelligence (EjoChat). If missing,
# iCode still works as a coding agent but Kinyarwanda explanations are limited.
EJOCHAT_API_KEY=ejochat_your_key_here

# Optional overrides (defaults are in config / examples):
# EJOCHAT_BASE_URL=https://api.ejolabs.com/api/v1   # official EjoChat API
# EJOCHAT_MODEL=claude-sonnet-4-5-20250929
# EJOCHAT_DISABLED=0
# ICODE_LANGUAGE=rw          # rw | auto | en
# ICODE_DEBUG=0
# ICODE_ASCII=0              # 1 forces ASCII-only terminal glyphs
# ICODE_NO_COLOR=0
